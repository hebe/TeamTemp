# Copy this to .env.local and fill in your Neon credentials.
# Find your connection string in the Neon dashboard → your project → Connection Details.
# Use the "Pooled connection" string for serverless/edge environments.

DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Super-admin token for /super/<token> dashboard
SUPER_ADMIN_TOKEN=change-me-to-something-secret
