# Copy this to .env.local and fill in your Neon credentials.
# Find both values in the Neon dashboard (or Vercel Storage tab) → Quickstart → .env.local

# Pooled connection — used by the app at runtime (via pgbouncer)
DATABASE_URL=postgresql://...@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct (unpooled) connection — used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=postgresql://...@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Super-admin token for /super/<token> dashboard
SUPER_ADMIN_TOKEN=change-me-to-something-secret
